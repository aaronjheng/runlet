          "product-name": "SwiftTreeSitter",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "tree-sitter",
          "product-name": "TreeSitter",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "tree-sitter-bash",
