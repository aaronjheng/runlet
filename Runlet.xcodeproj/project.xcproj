  "targets": [
    {
      "name": "Runlet",
      "id": "BB93DA1DE052699890633FD1",
      "product": "Products/Runlet.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "NIOSSH",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "StyLua",
          "product-name": "StyLua",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "plume",
          "product-name": "Plume",
          "build-phase": { "build-phase": "frameworks" },
